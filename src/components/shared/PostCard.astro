---
import type { PostEntry } from '../../lib/recap';
import { postHref } from '../../lib/paths';
import { formatDate, TYPE_LABEL } from '../../lib/format';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const href = postHref(post);
---

<li class="post-card">
  <a href={href} class="post-card-link">
    {post.data.coverImage && <img class="post-card-thumb" src={post.data.coverImage.src} alt="" />}
    <span class="post-card-body">
      <span class="post-card-toprow">
        <span class="post-card-type">{TYPE_LABEL[post.data.type]}</span>
        <span class="post-card-date">{formatDate(post.data.date)}</span>
      </span>
      <span class="post-card-title">{post.data.title}</span>
      <span class="post-card-summary">{post.data.summary}</span>
    </span>
  </a>
</li>

<style>
  .post-card {
    list-style: none;
    border-bottom: 1px solid #808080;
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card-link {
    display: flex;
    gap: 10px;
    padding: 10px 4px;
    text-decoration: none;
    color: inherit;
  }

  .post-card-link:hover .post-card-title {
    text-decoration: underline;
  }

  .post-card-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid #999;
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .post-card-toprow {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .post-card-type {
    font-family: 'Pixelated MS Sans Serif', Arial, sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #00006e;
  }

  .post-card-date {
    font-family: 'Pixelated MS Sans Serif', Arial, sans-serif;
    font-size: 10px;
    color: #555;
  }

  .post-card-title {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: bold;
    color: #111;
  }

  .post-card-summary {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    color: #333;
  }
</style>
