---
import { getCollection, render } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const logs = await getCollection('goalLogs', ({ data }) => !data.draft);
  return logs.map((log) => ({
    params: { slug: log.id },
    props: { log },
  }));
}

const { log } = Astro.props;
const { Content } = await render(log);
---

<DocumentLayout
  title={log.data.title}
  description={`${log.data.goalText} — ${log.data.title}`}
  kicker="Goal log"
  statusLeft={formatDate(log.data.date)}
  statusRight={log.data.rating ? '★'.repeat(log.data.rating) + '☆'.repeat(5 - log.data.rating) : undefined}
  coverImage={log.data.coverImage}
  gallery={log.data.gallery}
>
  <p class="goal-log-source">Goal: {log.data.goalText}</p>
  <Content />
</DocumentLayout>

<style>
  .goal-log-source {
    font-family: 'Pixelated MS Sans Serif', Arial, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #555;
    border-bottom: 1px solid #ccc;
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
</style>
