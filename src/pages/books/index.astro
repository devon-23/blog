---
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import MediaIndex from '../../components/shared/MediaIndex.astro';
import { getMediaLibrary } from '../../lib/media';
import { PROFILES } from '../../data/profiles';

const { books } = await getMediaLibrary();
const reading = books.filter((b) => b.shelf === 'currently-reading');
const read = books.filter((b) => b.shelf === 'read');
const rated = read.filter((b) => b.rating != null);
const avg = rated.length ? rated.reduce((sum, b) => sum + (b.rating ?? 0), 0) / rated.length : 0;
---

<DocumentLayout
  title="Books"
  kicker="the reading log"
  description="Every book I've read, with my ratings and reviews — pulled from Goodreads."
  statusLeft={`${read.length} read`}
  statusRight={rated.length ? `avg ${avg.toFixed(2)}★` : undefined}
>
  <p>
    Straight from <a href={PROFILES.goodreads.url} target="_blank" rel="noopener noreferrer">Goodreads</a>,
    rebuilt on every deploy. Books I rated or reviewed get their own page; the rest link out.
  </p>

  {
    reading.length > 0 && (
      <p class="books-reading-now">
        <strong>Reading now:</strong>{' '}
        {reading.map((book, i) => (
          <>
            {i > 0 && ', '}
            <a href={book.href ?? book.externalUrl}>{book.title}</a>
          </>
        ))}
      </p>
    )
  }

  <MediaIndex items={books} kind="book" />
</DocumentLayout>

<style>
  .books-reading-now {
    padding: 8px 12px;
    border-left: 3px solid #ff66cc;
    background: #f4f0fa;
  }
</style>
