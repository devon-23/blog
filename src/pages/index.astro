---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Desktop from '../components/desktop/Desktop';
import { getAllPublishedPosts, getAllPublishedRecommendations, getAllMonthKeys } from '../lib/recap';
import { postHref, recommendationHref, recapHref, goalLogHref } from '../lib/paths';
import { formatDate, formatMonthLabel } from '../lib/format';
import { CATEGORY_META } from '../data/categories';
import { getAllGalleryImages } from '../lib/gallery';
import { getMediaDiet } from '../lib/mediaDiet';
import { getMediaLibrary, type MediaItem } from '../lib/media';
import { getRankedListSlugs } from '../lib/feeds';
import { PROFILES } from '../data/profiles';
import type { DesktopData, DesktopMediaItem } from '../components/desktop/types';

const [posts, recommendations, monthKeys, goalEntries, galleryImages, mediaDiet, library] = await Promise.all([
  getAllPublishedPosts(),
  getAllPublishedRecommendations(),
  getAllMonthKeys(),
  getCollection('goals'),
  getAllGalleryImages(),
  getMediaDiet(),
  getMediaLibrary(),
]);

// Trim each item down to what the list actually renders. The full MediaItem
// carries review text and publisher blurbs, and 190 books' worth of that would
// be serialized into every page load for data no list row ever shows.
function toDesktopMedia(item: MediaItem): DesktopMediaItem {
  return {
    slug: item.slug,
    title: item.title,
    subtitle: item.subtitle,
    coverUrl: item.coverUrl,
    rating: item.rating,
    sortDate: item.date?.getTime() ?? 0,
    dateLabel: item.date ? formatDate(item.date) : undefined,
    meta: item.meta,
    playcount: item.playcount,
    externalUrl: item.externalUrl,
    href: item.hasPage ? item.href : undefined,
    hasNote: Boolean(item.entry),
  };
}

// Ranked list order, from the export CSV (list RSS is blocked by a Cloudflare
// challenge — see getRankedListSlugs()). Only films that already have a diary
// watch show up, since the CSV carries no poster art of its own.
const moviesBySlug = new Map(library.movies.map((item) => [item.slug, item]));
const rankedListSlugs = await getRankedListSlugs(PROFILES.letterboxd.lists.ranked2026.slug);
const rankedMovies: DesktopMediaItem[] = rankedListSlugs
  .map((slug, i): DesktopMediaItem | null => {
    const item = moviesBySlug.get(slug);
    return item ? { ...toDesktopMedia(item), rank: i + 1 } : null;
  })
  .filter((item): item is DesktopMediaItem => item !== null);

const goalsByMonth = new Map(goalEntries.map((g) => [g.data.month, g]));

// Anything published in the last two weeks gets the blinking NEW! tag. Decided
// here rather than in the browser so the tag can't flicker in after hydration.
const NEW_WINDOW_MS = 1000 * 60 * 60 * 24 * 14;
const isRecent = (date: Date) => Date.now() - date.getTime() < NEW_WINDOW_MS;

const desktopPosts = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  summary: post.data.summary,
  type: post.data.type,
  dateLabel: formatDate(post.data.date),
  href: postHref(post),
  coverImageSrc: post.data.coverImage?.src,
  isNew: isRecent(post.data.date),
}));

const desktopRecommendations = recommendations.map((rec) => {
  const meta = CATEGORY_META[rec.data.category];
  return {
    slug: rec.id,
    title: rec.data.title,
    summary: rec.data.summary,
    category: rec.data.category,
    categoryLabel: meta.label,
    categoryEmoji: meta.emoji,
    dateLabel: formatDate(rec.data.date),
    rating: rec.data.rating,
    href: recommendationHref(rec),
    coverImageSrc: rec.data.coverImage?.src,
    isNew: isRecent(rec.data.date),
  };
});

const desktopGalleryImages = galleryImages.map((img) => ({
  src: img.src,
  width: img.width,
  height: img.height,
  sourceTitle: img.sourceTitle,
  sourceHref: img.sourceHref,
  sourceKind: img.sourceKind,
  dateLabel: formatDate(img.date),
}));

const desktopMonths = monthKeys.map((key) => {
  const goalEntry = goalsByMonth.get(key);
  return {
    key,
    label: formatMonthLabel(key),
    href: recapHref(key),
    goals: goalEntry
      ? goalEntry.data.goals.map((g) => ({
          text: g.text,
          done: g.done,
          logHref: g.logSlug ? goalLogHref(g.logSlug) : undefined,
        }))
      : null,
  };
});

const desktopData: DesktopData = {
  posts: desktopPosts,
  recommendations: desktopRecommendations,
  months: desktopMonths,
  galleryImages: desktopGalleryImages,
  mediaDiet,
  movies: library.movies.map(toDesktopMedia),
  books: library.books.map(toDesktopMedia),
  albums: library.albums.map(toDesktopMedia),
  rankedMovies,
};
---

<BaseLayout title="devon's desktop">
  <Desktop client:only="react" data={desktopData} />
</BaseLayout>
