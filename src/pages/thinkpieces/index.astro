---
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import PostCard from '../../components/shared/PostCard.astro';
import { getPostsByType } from '../../lib/recap';

const posts = await getPostsByType('thinkpiece');
---

<DocumentLayout title="Think Pieces" kicker="Folder" statusRight={`${posts.length} item${posts.length === 1 ? '' : 's'}`}>
  {
    posts.length === 0 ? (
      <p>Nothing here yet.</p>
    ) : (
      <ul class="list">
        {posts.map((post) => <PostCard post={post} />)}
      </ul>
    )
  }
</DocumentLayout>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
